/* App version resource - linked via {$R 'Version.res' 'Version.rc'} in DFend.dpr.
   Keep in sync with Install\VersionSettings.nsi and product branding.
   Project Options "Include version information" must stay OFF to avoid a second VERSIONINFO. */
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "\0"
      VALUE "FileDescription", "DFendX\0"
      VALUE "FileVersion", "2.0.0.0\0"
      VALUE "InternalName", "DFendX\0"
      VALUE "LegalCopyright", "The DFendX Team\0"
      VALUE "OriginalFilename", "DFend.exe\0"
      VALUE "ProductName", "DFendX\0"
      VALUE "ProductVersion", "2.0.0.0\0"
      VALUE "Comments", "GPL v3\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1252
  END
END
